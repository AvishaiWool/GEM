< /* --------------------------------------------------------------------------------
<                    compare function for QUICKSORT
<    ----------------------------------------------------------------------------- */
< int compare_values( const void *arg1, const void *arg2 )
< {
< 	if(*(unsigned int *)arg1 > *(unsigned int *)arg2)
< 		return 1;
< 	else if(*(unsigned int *)arg1 == *(unsigned int *)arg2) 
< 		return 0;
< 	else
< 		return -1;
< }
